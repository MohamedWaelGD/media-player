{
  "name": "@mohamedwaelgd/media-player",
  "version": "0.1.0",
  "description": "Framework-agnostic TypeScript video player with tracking, streaming engines, and a customizable Web Component.",
  "keywords": [
    "video",
    "media",
    "player",
    "hls",
    "web-component",
    "typescript",
    "tracking"
  ],
  "license": "MIT",
  "author": "Mohamed Wael",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MohamedWaelGD/media-player.git"
  },
  "bugs": {
    "url": "https://github.com/MohamedWaelGD/media-player/issues"
  },
  "homepage": "https://github.com/MohamedWaelGD/media-player#readme",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./element": {
      "import": {
        "types": "./dist/element/index.d.ts",
        "default": "./dist/element/index.js"
      },
      "require": {
        "types": "./dist/element/index.d.cts",
        "default": "./dist/element/index.cjs"
      }
    },
    "./hls": {
      "import": {
        "types": "./dist/hls/index.d.ts",
        "default": "./dist/hls/index.js"
      },
      "require": {
        "types": "./dist/hls/index.d.cts",
        "default": "./dist/hls/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:browser": "npm run build && playwright test",
    "validate:package": "npm run typecheck && npm run lint && npm run format:check && npm run test && npm run build && publint && npm pack --dry-run",
    "prepublishOnly": "npm run validate:package"
  },
  "peerDependencies": {
    "hls.js": ">=1.5.0"
  },
  "peerDependenciesMeta": {
    "hls.js": {
      "optional": true
    }
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@playwright/test": "^1.49.1",
    "@types/node": "^22.10.5",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "globals": "^15.14.0",
    "hls.js": "^1.5.17",
    "playwright": "^1.49.1",
    "prettier": "^3.4.2",
    "publint": "^0.3.2",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.19.1",
    "vitest": "^2.1.8"
  },
  "dependencies": {
    "@phosphor-icons/webcomponents": "^2.1.5"
  }
}
